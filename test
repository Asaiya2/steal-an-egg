    function Tab:CreateSlider(c2)
        c2 = c2 or {}
        local flag    = c2.Flag or ("slider_" .. name .. "_" .. (c2.Name or tostring(nlo())))
        local minV    = (c2.Range and c2.Range[1]) or 0
        local maxV    = (c2.Range and c2.Range[2]) or 100
        local step    = c2.Increment or 1
        local suffix  = c2.Suffix or ""
        local val     = (cfg[flag] ~= nil) and cfg[flag] or (c2.CurrentValue or minV)
        val           = math.clamp(val, minV, maxV)

        local row     = makeRow(50)
        mk("TextLabel", {
            Position = UDim2.new(0,14,0,5), Size = UDim2.new(0.6,0,0,18),
            BackgroundTransparency = 1, Text = c2.Name or "Slider", TextColor3 = T.Text,
            TextSize = 12, Font = Enum.Font.Gotham, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 5,
        }, row)
        local valLabel = mk("TextLabel", {
            AnchorPoint = Vector2.new(1,0), Position = UDim2.new(1,-14,0,5), Size = UDim2.new(0.35,0,0,18),
            BackgroundTransparency = 1, Text = tostring(val) .. (suffix ~= "" and (" " .. suffix) or ""),
            TextColor3 = T.AccentText, TextSize = 11, Font = Enum.Font.GothamBold,
            TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 5,
        }, row)
        local track = mk("Frame", {
            Position = UDim2.new(0,14,0,30), Size = UDim2.new(1,-28,0,8),
            BackgroundColor3 = T.SliderBg, BorderSizePixel = 0, ZIndex = 5,
        }, row)
        cr(4, track); sk(T.Stroke, 1, track)
        local fill = mk("Frame", {
            Size = UDim2.new((val - minV) / (maxV - minV), 0, 1, 0),
            BackgroundColor3 = T.SliderFill, BorderSizePixel = 0, ZIndex = 6,
        }, track)
        cr(4, fill)

        local function setVal(v)
            v   = math.clamp(math.round(v / step) * step, minV, maxV)
            val = v
            local pct = (v - minV) / (maxV - minV)
            tw(fill, { Size = UDim2.new(pct, 0, 1, 0) }, 0.1)
            valLabel.Text = tostring(v) .. (suffix ~= "" and (" " .. suffix) or "")
            cfg[flag] = v; saveConfig()
            pcall(c2.Callback or function() end, v)
        end

        local dragging = false
        track.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                local pct = math.clamp((i.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
                setVal(minV + pct * (maxV - minV))
            end
        end)
        UserInputService.InputChanged:Connect(function(i)
            if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
                local pct = math.clamp((i.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
                setVal(minV + pct * (maxV - minV))
            end
        end)
        UserInputService.InputEnded:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
        end)
        row.MouseEnter:Connect(function() tw(row, { BackgroundColor3 = T.ElementHover }, 0.12) end)
        row.MouseLeave:Connect(function() tw(row, { BackgroundColor3 = T.Element }, 0.12) end)

        if c2.Callback then task.defer(function() pcall(c2.Callback, val) end) end

        local o = { CurrentValue = val }
        function o:Set(v) setVal(v); o.CurrentValue = val end
        function o:SetRange(newMin, newMax)
            newMin = tonumber(newMin) or minV
            newMax = tonumber(newMax) or maxV
            if newMax <= newMin then return end
            minV, maxV = newMin, newMax
            val = math.clamp(val, minV, maxV)
            local pct = (val - minV) / (maxV - minV)
            fill.Size = UDim2.new(pct, 0, 1, 0)
            valLabel.Text = tostring(val) .. (suffix ~= "" and (" " .. suffix) or "")
        end
        return o
    end

