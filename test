-- SOURCE -> ASAIYAH COMPATIBILITY ADAPTER
-- ============================================================
-- The original source used the Chilli UI API. This adapter maps its
-- controls onto the AsaiyaHub framework without importing the Chilli UI.
local function _flagName(prefix, name)
    local s = tostring(name or "control"):gsub("[^%w]+", "_")
    return "Source_" .. prefix .. "_" .. s
end

local function _wrapControl(obj, kind)
    obj = obj or {}
    if kind == "toggle" then
        local wrapped = obj
        wrapped._controller = {
            GetValue = function() return wrapped.CurrentValue == true end,
        }
        function wrapped:Get() return wrapped.CurrentValue == true end
        function wrapped:GetValue() return wrapped.CurrentValue == true end
        return wrapped
    elseif kind == "slider" then
        function obj:Get() return obj.CurrentValue end
        function obj:GetValue() return obj.CurrentValue end
        -- Source can dynamically change ranges. The Asaiya framework
        -- version used here does not need the range for the underlying
        -- automation logic, so retain the method for compatibility.
        function obj:SetRange(minV, maxV)
            obj._SourceMin = minV
            obj._SourceMax = maxV
            if obj._asaiyaSetRange then
                pcall(obj._asaiyaSetRange, minV, maxV)
            end
        end
        local nativeSetRange = obj.SetRange
        obj._asaiyaSetRange = nativeSetRange
        return obj
    elseif kind == "dropdown" then
        function obj:Get() return obj.CurrentOption end
