-- ============================================================
-- CONFIG SYSTEM (Auto-save/load by Flag)
-- ============================================================
local CONFIG_FILE = "AsaiyaHub_Config.json"
local cfg = {}

local function loadConfig()
    local ok2, data = pcall(function()
        if readfile then return HttpService:JSONDecode(readfile(CONFIG_FILE)) end
    end)
    if ok2 and type(data) == "table" then
        for k, v in pairs(data) do cfg[k] = v end
        print("[AsaiyaHub] Config loaded.")
    else
        print("[AsaiyaHub] No config found, using defaults.")
    end
end

local function saveConfig()
    pcall(function()
        if writefile then writefile(CONFIG_FILE, HttpService:JSONEncode(cfg)) end
    end)
end

loadConfig()

-- ============================================================
-- WEBHOOK HELPER
-- ============================================================
local function httpReq(opts)
    local fn = (syn and syn.request) or http_request or request or (fluxus and fluxus.request)
    if not fn then return false end
    local ok2 = pcall(fn, opts)
    return ok2
end

local function sendWebhook(embedData)
    if not cfg["webhook_url"] or cfg["webhook_url"] == "" then return false end
    return httpReq({
        Url     = cfg["webhook_url"],
        Method  = "POST",
        Headers = { ["Content-Type"] = "application/json" },
        Body    = HttpService:JSONEncode({
            username = "AsaiyaHub",
            embeds   = { embedData },
        }),
    })
end

