            print(Keybind.CurrentKeybind)

        AUTO-SAVE: Saves the selected key by Flag.

        EXAMPLE:
            local ToggleGuiKey = SettingsTab:CreateKeybind({
                Name     = "Toggle GUI Visibility",
                Default  = "RightShift",
                Flag     = "GUI_ToggleKey",
                Callback = function()
                    game.Players.LocalPlayer.PlayerGui.AsaiyaHub.Win.Visible =
                        not game.Players.LocalPlayer.PlayerGui.AsaiyaHub.Win.Visible
                end,
            })
    ]]
    function Tab:CreateKeybind(c2)
        c2 = c2 or {}
        local flag       = c2.Flag or ("keybind_" .. name .. "_" .. (c2.Name or tostring(nlo())))
        local currentKey = cfg[flag] or c2.Default or "None"
        local listening  = false
        local row        = makeRow(42)
        mk("TextLabel", {
            Position = UDim2.new(0,14,0,0), Size = UDim2.new(0.6,0,1,0),
            BackgroundTransparency = 1, Text = c2.Name or "Keybind", TextColor3 = T.Text,
            TextSize = 12, Font = Enum.Font.Gotham, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 5,
        }, row)
        local kb = mk("TextButton", {
            AnchorPoint = Vector2.new(1,0.5), Position = UDim2.new(1,-12,0.5,0), Size = UDim2.new(0,80,0,27),
            BackgroundColor3 = T.SliderBg, Text = "[" .. currentKey .. "]", TextColor3 = T.AccentText,
            TextSize = 11, Font = Enum.Font.GothamBold, BorderSizePixel = 0, ZIndex = 5,
        }, row)
        cr(6, kb); sk(T.Stroke, 1, kb)
        kb.MouseButton1Click:Connect(function()
            listening = true; kb.Text = "[...]"; kb.TextColor3 = T.SubText
        end)
        UserInputService.InputBegan:Connect(function(inp, gp)
            if listening then
                if inp.KeyCode ~= Enum.KeyCode.Unknown then
                    local k = tostring(inp.KeyCode):split(".")[3]
                    currentKey = k; kb.Text = "[" .. k .. "]"; kb.TextColor3 = T.AccentText
                    listening = false; cfg[flag] = k; saveConfig()
                end
            elseif not gp and currentKey ~= "None" then
                if inp.KeyCode == Enum.KeyCode[currentKey] then pcall(c2.Callback or function() end) end
            end
        end)
        row.MouseEnter:Connect(function() tw(row, { BackgroundColor3 = T.ElementHover }, 0.12) end)
        row.MouseLeave:Connect(function() tw(row, { BackgroundColor3 = T.Element }, 0.12) end)
        local o = { CurrentKeybind = currentKey }
        function o:Set(k) currentKey = k; o.CurrentKeybind = k; kb.Text = "[" .. k .. "]"; cfg[flag] = k; saveConfig() end
        return o
    end

    return Tab
end

