local function Notify(title, content, dur)
    task.spawn(function()
        local notif = mk("Frame", {
            Size = UDim2.new(1,0,0,0), BackgroundColor3 = T.NotifBg,
            BackgroundTransparency = 1, BorderSizePixel = 0, ClipsDescendants = true, ZIndex = 300,
