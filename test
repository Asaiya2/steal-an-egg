        mk("Frame", { Size = UDim2.new(0,3,1,0), BackgroundColor3 = T.Accent, BorderSizePixel = 0, ZIndex = 301 }, notif)
        local tl = mk("TextLabel", {
            Position = UDim2.new(0,12,0,8), Size = UDim2.new(1,-22,0,16),
            BackgroundTransparency = 1, Text = title, TextColor3 = T.Text,
            TextSize = 12, Font = Enum.Font.GothamBold, TextXAlignment = Enum.TextXAlignment.Left,
            TextTransparency = 1, ZIndex = 301,
        }, notif)
        local cl = mk("TextLabel", {
            Position = UDim2.new(0,12,0,26), Size = UDim2.new(1,-22,0,30),
            BackgroundTransparency = 1, Text = content, TextColor3 = T.SubText,
            TextSize = 11, Font = Enum.Font.Gotham, TextXAlignment = Enum.TextXAlignment.Left,
            TextWrapped = true, TextTransparency = 1, ZIndex = 301,
        }, notif)
        tw(notif, { Size = UDim2.new(1,0,0,64), BackgroundTransparency = 0.1 }, 0.3)
        task.wait(0.12); tw(tl, { TextTransparency = 0 }, 0.2); tw(cl, { TextTransparency = 0.2 }, 0.2)
        task.delay(dur or 4, function()
            tw(notif, { BackgroundTransparency = 1, Size = UDim2.new(1,0,0,0) }, 0.3)
            tw(tl, { TextTransparency = 1 }, 0.2); tw(cl, { TextTransparency = 1 }, 0.2)
            task.wait(0.35); pcall(function() notif:Destroy() end)
        end)
    end)
end

