-- Tab state
local tabBtns   = {}
local tabPages  = {}
local activeTab = nil

local function selectTab(name)
    if activeTab == name then return end
    activeTab = name
    for n, b in pairs(tabBtns) do
        local sel = (n == name)
        tw(b.bg,  { BackgroundColor3 = sel and T.SidebarSelected or T.Sidebar, BackgroundTransparency = sel and 0 or 1 }, 0.18)
        b.lbl.TextColor3 = sel and T.Text or T.SubText
        tw(b.bar, { BackgroundTransparency = sel and 0 or 1 }, 0.18)
    end
    for n, p in pairs(tabPages) do p.Visible = (n == name) end
end

