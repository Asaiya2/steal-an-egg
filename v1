local Window = {}

--[[
    HOW TO CREATE A TAB:
    ─────────────────────────────────────────────
    local MyTab = Window:CreateTab("Tab Name", orderNumber)

    orderNumber controls the sort order in the sidebar (1 = first, 2 = second, etc.)

    EXAMPLE:
        local MainTab      = Window:CreateTab("Main", 1)
        local AutoTab      = Window:CreateTab("Automatics", 2)
        local SettingsTab  = Window:CreateTab("Settings", 3)
]]
function Window:CreateTab(name, order)
    order = order or 99
    local bf = mk("Frame", {
        Name = name, Size = UDim2.new(1,0,0,34), BackgroundTransparency = 1,
        BorderSizePixel = 0, LayoutOrder = order, ZIndex = 3,
    }, sidebar)
    local bg = mk("Frame", { Size = UDim2.new(1,0,1,0), BackgroundColor3 = T.Sidebar, BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 3 }, bf)
    cr(7, bg)
    local bar = mk("Frame", {
        AnchorPoint = Vector2.new(0,0.5), Position = UDim2.new(0,0,0.5,0), Size = UDim2.new(0,3,0.55,0),
        BackgroundColor3 = T.Accent, BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 5,
    }, bf)
    cr(2, bar)
    local lbl = mk("TextLabel", {
        Position = UDim2.new(0,14,0,0), Size = UDim2.new(1,-18,1,0),
        BackgroundTransparency = 1, Text = name, TextColor3 = T.SubText,
        TextSize = 12, Font = Enum.Font.Gotham, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 5,
    }, bf)
    local cb = mk("TextButton", { Size = UDim2.new(1,0,1,0), BackgroundTransparency = 1, Text = "", ZIndex = 6 }, bf)
    cb.MouseEnter:Connect(function() if activeTab ~= name then tw(bg, { BackgroundColor3 = T.SidebarHover, BackgroundTransparency = 0 }, 0.12) end end)
    cb.MouseLeave:Connect(function() if activeTab ~= name then tw(bg, { BackgroundTransparency = 1 }, 0.12) end end)
    cb.MouseButton1Click:Connect(function() closeAllDropdowns(); selectTab(name) end)
    tabBtns[name] = { bg = bg, lbl = lbl, bar = bar }

    local page = mk("ScrollingFrame", {
        Name = name, Position = UDim2.new(0,0,0,4), Size = UDim2.new(1,0,1,-4),
        BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 3,
        ScrollBarImageColor3 = T.Accent, CanvasSize = UDim2.new(0,0,0,0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y, Visible = false, ZIndex = 3, ClipsDescendants = false,
    }, contentArea)
    mk("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0,5) }, page)
    mk("UIPadding", { PaddingTop = UDim.new(0,10), PaddingBottom = UDim.new(0,10), PaddingLeft = UDim.new(0,12), PaddingRight = UDim.new(0,12) }, page)
    tabPages[name] = page
    if not activeTab then selectTab(name) end

    -- ── TAB ELEMENT BUILDERS ────────────────────────────────
    local Tab   = {}
    local lo    = 0
    local function nlo() lo = lo + 1; return lo end
    local function makeRow(h, clip)
        local row = mk("Frame", {
            Size = UDim2.new(1,0,0,h or 42), BackgroundColor3 = T.Element,
            BorderSizePixel = 0, LayoutOrder = nlo(), ZIndex = 4,
            ClipsDescendants = clip or false,
        }, page)
        cr(7, row); sk(T.Stroke, 1, row)
        return row
    end

    -- ────────────────────────────────────────────────────────
    -- SECTION
    -- ────────────────────────────────────────────────────────
    --[[
        USAGE:
            Tab:CreateSection("Section Title")

        Sections don't have callbacks or flags. They're just visual separators.

        EXAMPLE:
            AutoTab:CreateSection("Gain Muscle")
    ]]
    function Tab:CreateSection(text)
        local s = mk("Frame", { Size = UDim2.new(1,0,0,24), BackgroundTransparency = 1, LayoutOrder = nlo(), ZIndex = 4 }, page)
        mk("TextLabel", {
            Size = UDim2.new(1,0,1,0), BackgroundTransparency = 1,
            Text = string.upper(text), TextColor3 = T.SectionText,
            TextSize = 10, Font = Enum.Font.GothamBold, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 5,
        }, s)
        mk("Frame", {
            AnchorPoint = Vector2.new(0,1), Position = UDim2.new(0,0,1,0),
            Size = UDim2.new(1,0,0,1), BackgroundColor3 = T.Stroke, BorderSizePixel = 0, ZIndex = 5,
        }, s)
    end

    -- ────────────────────────────────────────────────────────
    -- LABEL
    -- ────────────────────────────────────────────────────────
    --[[
        USAGE:
            local Label = Tab:CreateLabel("Some text here")
            Label:Set("New text")   -- update the label text later

        No flag. No auto-save.

        EXAMPLE:
            local StatusLabel = AutoTab:CreateLabel("Status: Idle")
            -- later in your code:
            StatusLabel:Set("Status: Farming")
    ]]
    function Tab:CreateLabel(text)
        local row = makeRow(34)
        local l = mk("TextLabel", {
            Position = UDim2.new(0,12,0,0), Size = UDim2.new(1,-24,1,0),
            BackgroundTransparency = 1, Text = text, TextColor3 = T.SubText,
            TextSize = 12, Font = Enum.Font.Gotham, TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true, ZIndex = 5,
        }, row)
        local o = {}
        function o:Set(v) l.Text = v end
        return o
    end

    -- ────────────────────────────────────────────────────────
    -- PARAGRAPH
    -- ────────────────────────────────────────────────────────
    --[[
        USAGE:
            Tab:CreateParagraph({
                Title   = "Title here",
                Content = "Description or info text here. Can be long.",
            })

        No flag. No auto-save. Just for displaying info.
    ]]
    function Tab:CreateParagraph(c2)
        c2 = c2 or {}
        local row = makeRow(58)
        mk("TextLabel", {
            Position = UDim2.new(0,14,0,8), Size = UDim2.new(1,-28,0,16),
            BackgroundTransparency = 1, Text = c2.Title or "", TextColor3 = T.Text,
            TextSize = 12, Font = Enum.Font.GothamBold, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 5,
        }, row)
        mk("TextLabel", {
            Position = UDim2.new(0,14,0,26), Size = UDim2.new(1,-28,0,28),
            BackgroundTransparency = 1, Text = c2.Content or "", TextColor3 = T.SubText,
            TextSize = 11, Font = Enum.Font.Gotham, TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true, ZIndex = 5,
        }, row)
    end

    -- ────────────────────────────────────────────────────────
    -- BUTTON
    -- ────────────────────────────────────────────────────────
    --[[
        USAGE:
            local Button = Tab:CreateButton({
                Name       = "Button Name",      -- text shown on the row
                ButtonText = "Run",              -- text on the button itself (optional, default "Run")
                Callback   = function()
                    -- code runs when button is clicked
                end,
            })

            Button:SetText("New Text")  -- change button text later

        No flag. Buttons don't save state.

        EXAMPLE:
            local RebirthBtn = AutoTab:CreateButton({
                Name       = "Reborn Now",
                ButtonText = "Reborn",
                Callback   = function()
                    -- fire reborn remote here
                    print("Reborn!")
                end,
            })
    ]]
    function Tab:CreateButton(c2)
        c2 = c2 or {}
        local row = makeRow(42)
        mk("TextLabel", {
            Position = UDim2.new(0,14,0,0), Size = UDim2.new(0.55,0,1,0),
            BackgroundTransparency = 1, Text = c2.Name or "Button", TextColor3 = T.Text,
            TextSize = 12, Font = Enum.Font.Gotham, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 5,
        }, row)
        local btn = mk("TextButton", {
            AnchorPoint = Vector2.new(1,0.5), Position = UDim2.new(1,-12,0.5,0), Size = UDim2.new(0,80,0,27),
            BackgroundColor3 = T.Accent, Text = c2.ButtonText or "Run", TextColor3 = Color3.new(1,1,1),
            TextSize = 11, Font = Enum.Font.GothamBold, BorderSizePixel = 0, ZIndex = 5,
        }, row)
        cr(6, btn)
        btn.MouseEnter:Connect(function() tw(btn, { BackgroundColor3 = T.AccentHover }, 0.12) end)
        btn.MouseLeave:Connect(function() tw(btn, { BackgroundColor3 = T.Accent }, 0.12) end)
        btn.MouseButton1Click:Connect(function()
            tw(btn, { Size = UDim2.new(0,74,0,25) }, 0.08)
            task.delay(0.09, function() tw(btn, { Size = UDim2.new(0,80,0,27) }, 0.14) end)
            pcall(c2.Callback or function() end)
        end)
        row.MouseEnter:Connect(function() tw(row, { BackgroundColor3 = T.ElementHover }, 0.12) end)
        row.MouseLeave:Connect(function() tw(row, { BackgroundColor3 = T.Element }, 0.12) end)
        local o = {}
        function o:SetText(t2) btn.Text = t2 end
        return o
    end

    -- ────────────────────────────────────────────────────────
    -- TOGGLE
    -- ────────────────────────────────────────────────────────
    --[[
        USAGE:
            local Toggle = Tab:CreateToggle({
                Name         = "Toggle Name",
                CurrentValue = false,   -- starting value (true = on, false = off)
                Flag         = "UniqueFlag1",  -- MUST be unique across all toggles!
                Callback     = function(Value)
                    -- Value is true when ON, false when OFF
                    if Value then
                        print("Toggled ON")
                    else
                        print("Toggled OFF")
                    end
                end,
            })

            Toggle:Set(true)   -- force toggle on from code
            Toggle:Set(false)  -- force toggle off from code
            print(Toggle.CurrentValue)  -- get current state

        AUTO-SAVE: The toggle state is saved to the config by its Flag.
        On re-execute, if it was ON, the Callback fires automatically with true.

        EXAMPLE:
            local AutoGainToggle = AutoTab:CreateToggle({
                Name         = "Auto Gain Muscle",
                CurrentValue = false,
                Flag         = "AutoFarm_GainMuscle",
                Callback     = function(Value)
                    getgenv().GainMuscle = Value
                    if Value then
                        task.spawn(function()
                            while getgenv().GainMuscle do
                                game:GetService("ReplicatedStorage").RemoteEvent:FireServer({[1]="GainMuscle"})
                                task.wait(0.45)
                            end
                        end)
                    end
                end,
            })
    ]]
    function Tab:CreateToggle(c2)
        c2 = c2 or {}
        local flag   = c2.Flag or ("toggle_" .. name .. "_" .. (c2.Name or tostring(nlo())))
        local val    = (cfg[flag] ~= nil) and cfg[flag] or (c2.CurrentValue or false)
        local row    = makeRow(42)
        mk("TextLabel", {
            Position = UDim2.new(0,14,0,0), Size = UDim2.new(0.7,0,1,0),
            BackgroundTransparency = 1, Text = c2.Name or "Toggle", TextColor3 = T.Text,
            TextSize = 12, Font = Enum.Font.Gotham, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 5,
        }, row)
        local track = mk("Frame", {
            AnchorPoint = Vector2.new(1,0.5), Position = UDim2.new(1,-14,0.5,0), Size = UDim2.new(0,44,0,23),
            BackgroundColor3 = val and T.ToggleOn or T.ToggleOff, BorderSizePixel = 0, ZIndex = 5,
        }, row)
        cr(12, track); sk(T.Stroke, 1, track)
        local knob = mk("Frame", {
            AnchorPoint = Vector2.new(0,0.5),
            Position = val and UDim2.new(1,-21,0.5,0) or UDim2.new(0,2,0.5,0),
            Size = UDim2.new(0,19,0,19), BackgroundColor3 = Color3.new(1,1,1), BorderSizePixel = 0, ZIndex = 6,
        }, track)
        cr(10, knob)
        local inter = mk("TextButton", { Size = UDim2.new(1,0,1,0), BackgroundTransparency = 1, Text = "", ZIndex = 7 }, row)
        inter.MouseButton1Click:Connect(function()
            val = not val
            tw(track, { BackgroundColor3 = val and T.ToggleOn or T.ToggleOff }, 0.18)
            tw(knob,  { Position = val and UDim2.new(1,-21,0.5,0) or UDim2.new(0,2,0.5,0) }, 0.18)
            cfg[flag] = val; saveConfig()
            pcall(c2.Callback or function() end, val)
        end)
        row.MouseEnter:Connect(function() tw(row, { BackgroundColor3 = T.ElementHover }, 0.12) end)
        row.MouseLeave:Connect(function() tw(row, { BackgroundColor3 = T.Element }, 0.12) end)
        if val and c2.Callback then task.defer(function() pcall(c2.Callback, true) end) end
        local o = { CurrentValue = val }
        function o:Set(v)
            val = v; o.CurrentValue = v
            tw(track, { BackgroundColor3 = v and T.ToggleOn or T.ToggleOff }, 0.18)
            tw(knob,  { Position = v and UDim2.new(1,-21,0.5,0) or UDim2.new(0,2,0.5,0) }, 0.18)
            cfg[flag] = v; saveConfig()
        end
        return o
    end

    -- ────────────────────────────────────────────────────────
    -- SLIDER
    -- ────────────────────────────────────────────────────────
    --[[
        USAGE:
            local Slider = Tab:CreateSlider({
                Name         = "Slider Name",
                Range        = {0, 100},    -- {min, max}
                Increment    = 10,          -- step size
                Suffix       = "ms",        -- unit shown after value (optional)
                CurrentValue = 50,          -- starting value
                Flag         = "UniqueFlag2",
                Callback     = function(Value)
                    -- Value is the current number
                    print("Slider value:", Value)
                end,
            })

            Slider:Set(75)           -- set slider value from code
            print(Slider.CurrentValue)

        AUTO-SAVE: Saves the slider value by its Flag.

        EXAMPLE:
            local SpeedSlider = SettingsTab:CreateSlider({
                Name         = "Gain Speed (ms)",
                Range        = {100, 1000},
                Increment    = 50,
                Suffix       = "ms",
                CurrentValue = 450,
                Flag         = "GainSpeed",
                Callback     = function(Value)
                    getgenv().GainDelay = Value / 1000
                    print("Set gain delay to", Value, "ms")
                end,
            })
    ]]
    function Tab:CreateSlider(c2)
        c2 = c2 or {}
        local flag    = c2.Flag or ("slider_" .. name .. "_" .. (c2.Name or tostring(nlo())))
        local minV    = (c2.Range and c2.Range[1]) or 0
        local maxV    = (c2.Range and c2.Range[2]) or 100
        local step    = c2.Increment or 1
        local suffix  = c2.Suffix or ""
        local val     = (cfg[flag] ~= nil) and cfg[flag] or (c2.CurrentValue or minV)
        val           = math.clamp(val, minV, maxV)

        local row     = makeRow(50)
        mk("TextLabel", {
            Position = UDim2.new(0,14,0,5), Size = UDim2.new(0.6,0,0,18),
            BackgroundTransparency = 1, Text = c2.Name or "Slider", TextColor3 = T.Text,
            TextSize = 12, Font = Enum.Font.Gotham, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 5,
        }, row)
        local valLabel = mk("TextLabel", {
            AnchorPoint = Vector2.new(1,0), Position = UDim2.new(1,-14,0,5), Size = UDim2.new(0.35,0,0,18),
            BackgroundTransparency = 1, Text = tostring(val) .. (suffix ~= "" and (" " .. suffix) or ""),
            TextColor3 = T.AccentText, TextSize = 11, Font = Enum.Font.GothamBold,
            TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 5,
        }, row)
        local track = mk("Frame", {
            Position = UDim2.new(0,14,0,30), Size = UDim2.new(1,-28,0,8),
            BackgroundColor3 = T.SliderBg, BorderSizePixel = 0, ZIndex = 5,
        }, row)
        cr(4, track); sk(T.Stroke, 1, track)
        local fill = mk("Frame", {
            Size = UDim2.new((val - minV) / (maxV - minV), 0, 1, 0),
            BackgroundColor3 = T.SliderFill, BorderSizePixel = 0, ZIndex = 6,
        }, track)
        cr(4, fill)

        local function setVal(v)
            v   = math.clamp(math.round(v / step) * step, minV, maxV)
            val = v
            local pct = (v - minV) / (maxV - minV)
            tw(fill, { Size = UDim2.new(pct, 0, 1, 0) }, 0.1)
            valLabel.Text = tostring(v) .. (suffix ~= "" and (" " .. suffix) or "")
            cfg[flag] = v; saveConfig()
            pcall(c2.Callback or function() end, v)
        end

        local dragging = false
        track.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                local pct = math.clamp((i.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
                setVal(minV + pct * (maxV - minV))
            end
        end)
        UserInputService.InputChanged:Connect(function(i)
            if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
                local pct = math.clamp((i.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
                setVal(minV + pct * (maxV - minV))
            end
        end)
        UserInputService.InputEnded:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
        end)
        row.MouseEnter:Connect(function() tw(row, { BackgroundColor3 = T.ElementHover }, 0.12) end)
        row.MouseLeave:Connect(function() tw(row, { BackgroundColor3 = T.Element }, 0.12) end)

        if c2.Callback then task.defer(function() pcall(c2.Callback, val) end) end

        local o = { CurrentValue = val }
        function o:Set(v) setVal(v); o.CurrentValue = val end
        return o
    end

    -- ────────────────────────────────────────────────────────
    -- INPUT
    -- ────────────────────────────────────────────────────────
    --[[
        USAGE:
            local Input = Tab:CreateInput({
                Name                   = "Input Name",
                CurrentValue           = "",          -- default text
                PlaceholderText        = "Type here...",
                RemoveTextAfterFocusLost = false,     -- clear on click?
                Flag                   = "UniqueFlag3",
                Callback               = function(Text)
                    -- Text is the string typed in the box
                    print("Input value:", Text)
                end,
            })

            Input:Set("new value")   -- set input text from code
            print(Input.CurrentValue)

        AUTO-SAVE: Saves the text by its Flag.

        EXAMPLE:
            local WebhookInput = WebhookTab:CreateInput({
                Name            = "Webhook URL",
                PlaceholderText = "https://discord.com/api/webhooks/...",
                Flag            = "MyScript_WebhookURL",
                Callback        = function(Text)
                    getgenv().MyWebhookURL = Text
                end,
            })
    ]]
    function Tab:CreateInput(c2)
        c2 = c2 or {}
        local flag = c2.Flag or ("input_" .. name .. "_" .. (c2.Name or tostring(nlo())))
        local row  = makeRow(42)
        mk("TextLabel", {
            Position = UDim2.new(0,14,0,0), Size = UDim2.new(0.34,0,1,0),
            BackgroundTransparency = 1, Text = c2.Name or "Input", TextColor3 = T.Text,
            TextSize = 12, Font = Enum.Font.Gotham, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 5,
        }, row)
        local box = mk("Frame", {
            AnchorPoint = Vector2.new(1,0.5), Position = UDim2.new(1,-12,0.5,0), Size = UDim2.new(0,168,0,27),
            BackgroundColor3 = T.SliderBg, BorderSizePixel = 0, ZIndex = 5,
        }, row)
        cr(6, box); sk(T.Stroke, 1, box)
        local tb = mk("TextBox", {
            Position = UDim2.new(0,8,0,0), Size = UDim2.new(1,-14,1,0),
            BackgroundTransparency = 1, Text = cfg[flag] or c2.CurrentValue or "",
            PlaceholderText = c2.PlaceholderText or "Enter value...", PlaceholderColor3 = T.SectionText,
            TextColor3 = T.Text, TextSize = 11, Font = Enum.Font.Gotham, TextXAlignment = Enum.TextXAlignment.Left,
            ClearTextOnFocus = c2.RemoveTextAfterFocusLost or false, ZIndex = 6,
        }, box)
        tb.FocusLost:Connect(function()
            cfg[flag] = tb.Text; saveConfig()
            pcall(c2.Callback or function() end, tb.Text)
        end)
        row.MouseEnter:Connect(function() tw(row, { BackgroundColor3 = T.ElementHover }, 0.12) end)
        row.MouseLeave:Connect(function() tw(row, { BackgroundColor3 = T.Element }, 0.12) end)
        if c2.Callback and (cfg[flag] or c2.CurrentValue) and (cfg[flag] or c2.CurrentValue) ~= "" then
            task.defer(function() pcall(c2.Callback, cfg[flag] or c2.CurrentValue) end)
        end
        local o = { CurrentValue = tb.Text }
        function o:Set(v) tb.Text = v; o.CurrentValue = v; cfg[flag] = v; saveConfig() end
