    end

    -- ────────────────────────────────────────────────────────
    -- DROPDOWN
    -- ────────────────────────────────────────────────────────
    --[[
        USAGE:
            local Dropdown = Tab:CreateDropdown({
                Name            = "Dropdown Name",
                Options         = {"Option 1", "Option 2", "Option 3"},
                CurrentOption   = {"Option 1"},   -- default selected (table with 1 or more strings)
                MultipleOptions = false,           -- true = allow selecting multiple at once
                Flag            = "UniqueFlag4",
                Callback        = function(Options)
                    -- Options is a TABLE of selected strings (even if only 1 selected)
                    print("Selected:", Options[1])
                end,
            })

            Dropdown:Set("Option 2")           -- change selection from code
            Dropdown:SetOptions({"A","B","C"}) -- refresh the option list
            print(Dropdown.CurrentOption[1])   -- get current selection

        AUTO-SAVE: Saves the selected option(s) by Flag.

        EXAMPLE:
            local SellDropdown = AutoTab:CreateDropdown({
                Name          = "Auto Sell Speed",
                Options       = {"None","Instant","Every 1s","Every 5s","Every 30s"},
                CurrentOption = {"None"},
                Flag          = "AutoFarm_SellSpeed",
                Callback      = function(Options)
                    local mode = Options[1]
                    getgenv().SellMode = mode
                    -- your sell logic here
                end,
            })
    ]]
    function Tab:CreateDropdown(c2)
        c2 = c2 or {}
        local flag          = c2.Flag or ("dropdown_" .. name .. "_" .. (c2.Name or tostring(nlo())))
        local options       = c2.Options or {}
        local multiSelect   = c2.MultipleOptions or false
        local defaultOpts   = c2.CurrentOption or { options[1] or "None" }
        local selectedSet   = {}

        -- Restore from config
        local saved = cfg[flag]
        if saved and type(saved) == "table" then
            for _, v in pairs(saved) do selectedSet[v] = true end
        elseif saved and type(saved) == "string" then
            selectedSet[saved] = true
        else
            for _, v in pairs(defaultOpts) do selectedSet[v] = true end
        end

        -- Validate saved options still exist
        for k in pairs(selectedSet) do
            local found = false
            for _, o in pairs(options) do if o == k then found = true; break end end
            if not found then selectedSet[k] = nil end
        end
        if not next(selectedSet) and options[1] then selectedSet[options[1]] = true end

        local function getSelected()
            local t = {}
            for k in pairs(selectedSet) do table.insert(t, k) end
            return t
        end
        local function getDisplayText()
            local sel = getSelected()
            if #sel == 0 then return "None" end
            if #sel == 1 then return sel[1] end
            return sel[1] .. " (+" .. (#sel-1) .. ")"
        end

        local open = false
        local row  = makeRow(42)
        row.ClipsDescendants = false

        mk("TextLabel", {
            Position = UDim2.new(0,14,0,0), Size = UDim2.new(0.42,0,1,0),
            BackgroundTransparency = 1, Text = c2.Name or "Dropdown", TextColor3 = T.Text,
            TextSize = 12, Font = Enum.Font.Gotham, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 5,
        }, row)

        local sb = mk("TextButton", {
            AnchorPoint = Vector2.new(1,0.5), Position = UDim2.new(1,-12,0.5,0), Size = UDim2.new(0,140,0,27),
            BackgroundColor3 = T.SliderBg, Text = getDisplayText(), TextColor3 = T.Text,
            TextSize = 11, Font = Enum.Font.Gotham, BorderSizePixel = 0, ZIndex = 5,
        }, row)
        cr(6, sb); sk(T.Stroke, 1, sb)
        mk("TextLabel", {
            AnchorPoint = Vector2.new(1,0.5), Position = UDim2.new(1,-7,0.5,0), Size = UDim2.new(0,12,0,12),
            BackgroundTransparency = 1, Text = "▾", TextColor3 = T.SubText,
            TextSize = 9, Font = Enum.Font.GothamBold, ZIndex = 6,
        }, sb)

        local lf = mk("ScrollingFrame", {
            Size = UDim2.new(0,152,0,0), BackgroundColor3 = Color3.fromRGB(22,22,30),
            BorderSizePixel = 0, ZIndex = 500, Visible = false, ClipsDescendants = true,
            ScrollBarThickness = 3, ScrollBarImageColor3 = T.Accent,
            CanvasSize = UDim2.new(0,0,0,0), AutomaticCanvasSize = Enum.AutomaticSize.Y,
        }, sg)
        cr(8, lf); sk(T.Stroke, 1, lf)
        mk("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0,2) }, lf)
        mk("UIPadding", { PaddingTop = UDim.new(0,4), PaddingBottom = UDim.new(0,4), PaddingLeft = UDim.new(0,4), PaddingRight = UDim.new(0,4) }, lf)

        local function positionDropdown()
            local ap = sb.AbsolutePosition; local as2 = sb.AbsoluteSize
            lf.Position = UDim2.new(0, ap.X + as2.X - 152, 0, ap.Y + as2.Y + 4)
        end

        local ob2 = {}
        local th  = 8

        local function closeThis()
            open = false
            tw(lf, { Size = UDim2.new(0,152,0,0) }, 0.15)
            task.delay(0.16, function() lf.Visible = false end)
            openDropdowns[lf] = nil
        end

        local function saveAndFire()
            local sel = getSelected()
            local saveVal = multiSelect and sel or (sel[1] or "None")
            cfg[flag] = saveVal; saveConfig()
            sb.Text = getDisplayText()
            pcall(c2.Callback or function() end, sel)
        end

        local function rebuild(opts)
            for _, child in pairs(lf:GetChildren()) do
                if child:IsA("TextButton") then child:Destroy() end
            end
            ob2 = {}; th = 8
            for i, opt in ipairs(opts) do
                local isSel = selectedSet[opt] == true
                local o = mk("TextButton", {
                    Size = UDim2.new(1,0,0,27), BackgroundColor3 = isSel and T.SidebarSelected or T.Sidebar,
                    Text = opt, TextColor3 = isSel and T.Text or T.SubText,
                    TextSize = 11, Font = Enum.Font.Gotham, BorderSizePixel = 0, ZIndex = 501, LayoutOrder = i,
                }, lf)
                cr(5, o); th = th + 31
                o.MouseEnter:Connect(function()
                    if not selectedSet[opt] then tw(o, { BackgroundColor3 = T.SidebarHover }, 0.1) end
                end)
                o.MouseLeave:Connect(function()
                    if not selectedSet[opt] then tw(o, { BackgroundColor3 = T.Sidebar }, 0.1) end
                end)
                o.MouseButton1Click:Connect(function()
                    if multiSelect then
                        selectedSet[opt] = not selectedSet[opt] or nil
                        tw(o, { BackgroundColor3 = selectedSet[opt] and T.SidebarSelected or T.Sidebar }, 0.1)
                        o.TextColor3 = selectedSet[opt] and T.Text or T.SubText
                    else
                        for k in pairs(selectedSet) do selectedSet[k] = nil end
                        selectedSet[opt] = true
                        for _, b in pairs(ob2) do tw(b, { BackgroundColor3 = T.Sidebar }, 0.1); b.TextColor3 = T.SubText end
                        tw(o, { BackgroundColor3 = T.SidebarSelected }, 0.1); o.TextColor3 = T.Text
                        closeThis()
                    end
                    saveAndFire()
                end)
                ob2[opt] = o
            end
        end
        rebuild(options)

        local function openThis()
            closeAllDropdowns(); open = true
            positionDropdown(); lf.Size = UDim2.new(0,152,0,0); lf.Visible = true
            tw(lf, { Size = UDim2.new(0,152,0,math.min(th,260)) }, 0.2)
            openDropdowns[lf] = closeThis
        end

        sb.MouseButton1Click:Connect(function() if open then closeThis() else openThis() end end)
        row.MouseEnter:Connect(function() tw(row, { BackgroundColor3 = T.ElementHover }, 0.12) end)
        row.MouseLeave:Connect(function() tw(row, { BackgroundColor3 = T.Element }, 0.12) end)

        if c2.Callback then task.defer(function() pcall(c2.Callback, getSelected()) end) end

        local dobj = {}
        dobj.CurrentOption = getSelected()
        function dobj:Set(v)
            for k in pairs(selectedSet) do selectedSet[k] = nil end
            selectedSet[v] = true; saveAndFire(); dobj.CurrentOption = getSelected()
            for opt, b in pairs(ob2) do
                tw(b, { BackgroundColor3 = opt == v and T.SidebarSelected or T.Sidebar }, 0.1)
                b.TextColor3 = opt == v and T.Text or T.SubText
            end
        end
        function dobj:SetOptions(newOpts) options = newOpts; rebuild(newOpts) end
        return dobj
    end

    -- ────────────────────────────────────────────────────────
    -- KEYBIND
    -- ────────────────────────────────────────────────────────
    --[[
        USAGE:
            local Keybind = Tab:CreateKeybind({
                Name    = "Keybind Name",
                Default = "RightShift",   -- default key (string, e.g. "F", "RightControl")
                Flag    = "UniqueFlag5",
                Callback = function()
                    -- runs when the key is pressed
                    print("Keybind pressed!")
                end,
            })

            Keybind:Set("LeftAlt")    -- change key from code
            print(Keybind.CurrentKeybind)

        AUTO-SAVE: Saves the selected key by Flag.

        EXAMPLE:
            local ToggleGuiKey = SettingsTab:CreateKeybind({
                Name     = "Toggle GUI Visibility",
                Default  = "RightShift",
                Flag     = "GUI_ToggleKey",
                Callback = function()
                    game.Players.LocalPlayer.PlayerGui.AsaiyaHub.Win.Visible =
                        not game.Players.LocalPlayer.PlayerGui.AsaiyaHub.Win.Visible
                end,
            })
    ]]
    function Tab:CreateKeybind(c2)
        c2 = c2 or {}
        local flag       = c2.Flag or ("keybind_" .. name .. "_" .. (c2.Name or tostring(nlo())))
        local currentKey = cfg[flag] or c2.Default or "None"
        local listening  = false
        local row        = makeRow(42)
        mk("TextLabel", {
            Position = UDim2.new(0,14,0,0), Size = UDim2.new(0.6,0,1,0),
            BackgroundTransparency = 1, Text = c2.Name or "Keybind", TextColor3 = T.Text,
            TextSize = 12, Font = Enum.Font.Gotham, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 5,
        }, row)
        local kb = mk("TextButton", {
            AnchorPoint = Vector2.new(1,0.5), Position = UDim2.new(1,-12,0.5,0), Size = UDim2.new(0,80,0,27),
            BackgroundColor3 = T.SliderBg, Text = "[" .. currentKey .. "]", TextColor3 = T.AccentText,
            TextSize = 11, Font = Enum.Font.GothamBold, BorderSizePixel = 0, ZIndex = 5,
        }, row)
        cr(6, kb); sk(T.Stroke, 1, kb)
        kb.MouseButton1Click:Connect(function()
            listening = true; kb.Text = "[...]"; kb.TextColor3 = T.SubText
        end)
        UserInputService.InputBegan:Connect(function(inp, gp)
            if listening then
                if inp.KeyCode ~= Enum.KeyCode.Unknown then
                    local k = tostring(inp.KeyCode):split(".")[3]
                    currentKey = k; kb.Text = "[" .. k .. "]"; kb.TextColor3 = T.AccentText
                    listening = false; cfg[flag] = k; saveConfig()
                end
            elseif not gp and currentKey ~= "None" then
                if inp.KeyCode == Enum.KeyCode[currentKey] then pcall(c2.Callback or function() end) end
            end
        end)
        row.MouseEnter:Connect(function() tw(row, { BackgroundColor3 = T.ElementHover }, 0.12) end)
        row.MouseLeave:Connect(function() tw(row, { BackgroundColor3 = T.Element }, 0.12) end)
        local o = { CurrentKeybind = currentKey }
        function o:Set(k) currentKey = k; o.CurrentKeybind = k; kb.Text = "[" .. k .. "]"; cfg[flag] = k; saveConfig() end
        return o
    end

    return Tab
end

